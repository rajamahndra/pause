{
  "name": "pause",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:offline && prisma generate && next build",
    "build:offline": "node --experimental-strip-types scripts/build-offline.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.16.3",
    "argon2": "^0.44.0",
    "zod": "^4.1.0",
    "@tanstack/react-query": "^5.90.0",
    "react-hook-form": "^7.65.0",
    "@hookform/resolvers": "^5.2.0",
    "lucide-react": "^0.468.0",
    "@js-temporal/polyfill": "^0.5.1",
    "gray-matter": "^4.0.3",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "marked": "^17.0.0",
    "sanitize-html": "^2.17.0",
    "server-only": "^0.0.1",
    "dotenv": "^17.2.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0",
    "@playwright/test": "^1.56.0",
    "sharp": "^0.34.0",
    "@fontsource/dm-serif-display": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "prisma@7.10.0": true,
    "sharp@0.35.5": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  },
  "type": "module"
}
